# Copy this file to .env and replace every placeholder before starting the app.
DB_URL=jdbc:mysql://localhost:3306/languagecenterdb?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# HS256 requires a random secret of at least 32 bytes.
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MS=86400000

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# Student lesson reminders: one bulk database job, not one timer per user.
LESSON_REMINDER_CHECK_MS=60000
LESSON_REMINDER_INITIAL_DELAY_MS=15000
LESSON_REMINDER_LOOKBACK_MINUTES=10
# Each batch contains at most 1,000 notifications; 20 batches = 20,000 per cycle.
LESSON_REMINDER_MAX_BATCHES=20

# Transactional email. Railway/Render can use Brevo over HTTPS port 443.
MAIL_ENABLED=false
MAIL_PROVIDER=brevo
MAIL_FROM=Lingua Center <your-verified-sender@example.com>
BREVO_API_KEY=xkeysib-CHANGE_ME
BREVO_BASE_URL=https://api.brevo.com

# Optional SMTP fallback for local development. Set MAIL_PROVIDER=smtp to use it.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-address@gmail.com
SPRING_MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
# Class-open announcements load recipients in bounded pages.
MAIL_STUDENT_BATCH_SIZE=200
MAIL_EXECUTOR_CORE_POOL_SIZE=2
MAIL_EXECUTOR_MAX_POOL_SIZE=4
MAIL_EXECUTOR_QUEUE_CAPACITY=100

# Cloudinary: copy the CLOUDINARY_URL from Cloudinary Console.
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://CHANGE_ME:CHANGE_ME@CHANGE_ME
# Giới hạn ảnh tải lên, mặc định 5 MB.
CLOUDINARY_IMAGE_MAX_SIZE_BYTES=5242880

# Firebase Realtime Database chat.
# Encode the downloaded service-account JSON as one Base64 line; never commit the JSON/key.
FIREBASE_ENABLED=false
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=CHANGE_ME

# Có thể để trống để backend tự tìm DejaVu Sans trên Linux hoặc Arial trên Windows.
# Chỉ cần khai báo khi máy chủ cài font ở vị trí khác.
INVOICE_PDF_FONT_PATH=

# MoMo sandbox
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_REFUND_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund/query
MOMO_PARTNER_CODE=CHANGE_ME
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_REDIRECT_URL=http://localhost:5173/thanh-toan/ket-qua?provider=MOMO
MOMO_IPN_URL=https://YOUR_PUBLIC_BACKEND/api/payments/momo/ipn

# ZaloPay sandbox
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_REFUND_ENDPOINT=https://sb-openapi.zalopay.vn/v2/refund
ZALOPAY_REFUND_QUERY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query_refund
ZALOPAY_APP_ID=CHANGE_ME
ZALOPAY_KEY1=CHANGE_ME
ZALOPAY_KEY2=CHANGE_ME
ZALOPAY_CALLBACK_URL=https://YOUR_PUBLIC_BACKEND/api/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:5173/thanh-toan/ket-qua?provider=ZALOPAY
